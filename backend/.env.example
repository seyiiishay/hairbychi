# Copy to .env for local development. Railway/production sets these as real
# environment variables instead — never commit a real .env file.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
APP_ENV=development
DJANGO_ALLOWED_HOSTS=*

# Leave unset to use local sqlite. Railway provides this automatically for
# its Postgres plugin.
# DATABASE_URL=postgres://user:password@host:5432/dbname

CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Business rules (ENV constants — PRD Sections 5 & 6.1) -----------------
BUFFER_MINUTES=30
# ⚠️ OPEN in the PRD — confirm the real number with the client before launch.
DEPOSIT_THRESHOLD_AMOUNT=75.00
DEPOSIT_AMOUNT_SINGLE_SERVICE=20.00
DEPOSIT_AMOUNT_MULTI_SERVICE=30.00
STRIKE_HIGH_RISK_COUNT=2
LATE_ARRIVAL_GRACE_MINUTES=15
CLIENT_ACTION_CUTOFF_HOURS=24
# ⚠️ OPEN in the PRD (Section 9) — confirm the real timeout before launch.
ADMIN_SESSION_TIMEOUT_MINUTES=60

# --- Stripe ------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- CAPTCHA (hcaptcha | turnstile) ------------------------------------------
CAPTCHA_PROVIDER=hcaptcha
CAPTCHA_SECRET_KEY=
# Set True to skip real verification in local dev (defaults to DJANGO_DEBUG).
CAPTCHA_BYPASS=True

# --- Resend (leave RESEND_API_KEY unset to log emails instead of sending) ---
RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL=bookings@braidsbychi.app.ekanets.com

PUBLIC_SITE_URL=http://localhost:5173
PUBLIC_API_BASE_URL=http://localhost:8000

ADMIN_TOTP_ISSUER=BraidsByChi
